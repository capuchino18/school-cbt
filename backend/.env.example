# Connection string database PostgreSQL (Supabase/Railway/Neon/dll)
DATABASE_URL="postgresql://user:password@host:port/dbname"

# Port server backend
PORT=5000

# Secret untuk penandatanganan JSON Web Token (JWT) — gunakan string acak yang panjang & rahasia
JWT_SECRET="ganti_dengan_secret_acak_yang_panjang"

# Daftar email yang diberi akses sebagai ADMIN, dipisahkan koma
ADMIN_WHITELIST_EMAILS="admin1@email.com,admin2@email.com"

# Origin frontend yang diizinkan mengakses backend (CORS), dipisahkan koma jika lebih dari satu.
# Isi dengan domain produksi Vercel, contoh:
# CLIENT_URL="https://nama-proyek.vercel.app,http://localhost:3000"
CLIENT_URL="http://localhost:3000"
